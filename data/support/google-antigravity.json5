    },
    {
      feature_id: "mcp-support",
      support_level: "yes",
      notes: "Antigravity supports MCP servers, configured in Settings (Antigravity 2.0), the MCP Store (IDE), or mcp_config.json at global (~/.gemini/config/) or workspace (.agents/) level for the CLI.",
