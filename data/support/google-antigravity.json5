      last_verified: "2026-09-30",
      sources: ["https://antigravity.google/docs/mcp/"]
    },
    {
      feature_id: "planner-strategy",
      support_level: "yes",
      notes: "The agent uses an Implementation Plan artifact to architect changes before executing them; you can trigger planning with /plan and comment on the plan.",
      examples: ["Reviewing and commenting on an implementation plan before the agent starts"],
      last_verified: "2026-09-30",
      sources: ["https://antigravity.google/docs/implementation-plan/"]
    },
    {
      feature_id: "supports-scoped-instructions",
      support_level: "yes",
      notes: "Rules are cumulative across global (~/.gemini/AGENTS.md, ~/.gemini/GEMINI.md, ~/.gemini/config/rules/) and workspace scopes, with more specific directory-level rules taking precedence.",
      examples: ["A global rule for personal preferences plus a directory-level AGENTS.md"],
