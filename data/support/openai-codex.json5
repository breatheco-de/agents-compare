// Support matrix for OpenAI Codex
// This file defines how well OpenAI Codex supports various features
{
  agent_id: "openai-codex",
  feature_support: [
    {
      feature_id: "automatic-context-awareness",
      support_level: "yes",
      notes: "The IDE extension starts from what you already have open: it references open files, selected code, and recent chats from the composer, and the CLI /ide command pulls open files and the current selection into the prompt.",
      examples: ["Asking Codex about the function selected in the editor"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/codex/ide", "https://learn.chatgpt.com/docs/developer-commands?surface=cli"]
    },
    {
      feature_id: "broad-ide-integration",
      support_level: "partial",
      notes: "The Codex IDE extension supports VS Code and VS Code-based editors such as Cursor and Devin Desktop (formerly Windsurf). Other IDE families are not listed.",
      examples: ["Using the Codex extension inside Cursor"],
      last_verified: "2026-09-30",
      sources: ["https://github.com/openai/codex"]
    },
    {
      feature_id: "claude-latest-support",
      support_level: "unknown",
      notes: "Not documented: the full official documentation (https://learn.chatgpt.com/llms-full.txt) was searched on 2026-09-30 without finding this capability. This does not mean the tool lacks it. Claude only appears as a migration source (importing CLAUDE.md and skills).",
      examples: [],
      last_verified: "2026-09-30",
      sources: []
    },
    {
      feature_id: "console-error-integration",
      support_level: "yes",
      notes: "In the ChatGPT desktop app, Developer mode gives the agent controlled Chrome DevTools Protocol access to inspect console output and network traffic in the live browser. It is opt-in (Settings > Browser > Enable full CDP access) and admins can disable it.",
      examples: ["Asking Codex to read the console errors of the page open in the built-in browser"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/browser"]
    },
    {
      feature_id: "context-window",
      support_level: "unknown",
      notes: "Not documented: the full official documentation (https://learn.chatgpt.com/llms-full.txt) was searched on 2026-09-30 without finding this capability. This does not mean the tool lacks it. The docs describe context compaction and a configurable model_context_window, but no window size per model.",
      examples: [],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/models"]
    },
    {
      feature_id: "dedicated-instruction-file",
      support_level: "yes",
      notes: "Codex reads AGENTS.md (or AGENTS.override.md) files for persistent instructions.",
      examples: ["Adding test and lint commands to AGENTS.md"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/agent-configuration/agents-md"]
    },
    {
      feature_id: "filesystem-access",
      support_level: "yes",
      notes: "In the default workspace-write sandbox, Codex can read files, make edits, and run commands in the workspace; it requires approval to edit outside the workspace.",
      examples: ["Letting Codex fix failing tests and edit the affected files"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/codex/agent-approvals-security"]
    },
    {
      feature_id: "fine-grained-instruction-control",
      support_level: "partial",
      notes: "AGENTS.md files in nested directories are concatenated from the Git root down, so files closer to the working directory override earlier guidance. Glob-based targeting is not documented.",
      examples: ["A packages/api/AGENTS.md with backend-specific rules"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/agent-configuration/agents-md"]
    },
    {
      feature_id: "interactive-element-selection",
      support_level: "yes",
      notes: "In the built-in browser, Annotate mode lets you click an element or drag to select an area, leave a comment, and ask the agent to address it.",
      examples: ["Annotating an overflowing button and asking Codex to fix it"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/browser"]
    },
    {
      feature_id: "live-web-preview",
      support_level: "yes",
      notes: "The ChatGPT desktop app has a built-in browser: start your dev server, open the local route, and review the rendered page alongside the code diff.",
      examples: ["Previewing a local dev server next to the diff"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/browser"]
    },
    {
      feature_id: "mcp-support",
      support_level: "yes",
      notes: "The ChatGPT desktop app, Codex CLI, and IDE extension support MCP servers and share MCP configuration for the same Codex host.",
      examples: ["Adding a documentation MCP server to the Codex CLI"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/extend/mcp?surface=cli"]
    },
    {
      feature_id: "planner-strategy",
      support_level: "yes",
      notes: "The /plan command switches the chat into plan mode so Codex proposes an execution plan before implementation starts.",
      examples: ["/plan Propose a migration plan for this service"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/developer-commands?surface=cli"]
    },
    {
      feature_id: "supports-scoped-instructions",
      support_level: "yes",
      notes: "Instructions are layered: a global file in ~/.codex, then project files from the Git root down to the working directory.",
      examples: ["A global ~/.codex/AGENTS.md plus a project AGENTS.md"],
      last_verified: "2026-09-30",
      sources: ["https://learn.chatgpt.com/docs/agent-configuration/agents-md"]
    }
  ]
}
